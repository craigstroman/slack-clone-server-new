{
  "name": "slack-clone-server",
  "version": "1.0.0",
  "description": "A clone of Slack using GraphQL.",
  "repository": "https://github.com/craigstroman/slack-clone-server.git",
  "main": "src/index.ts",
  "scripts": {
    "watch": "tsc -w --preserveWatchOutput & copyfiles -f ./src/views/*.pug ./dist/views",
    "start": "NODE_ENV=production node ./dist/index.js",
    "live:server": "NODE_ENV=development nodemon ./dist/index.js",
    "copy-files:server": "copyfiles -f ./views/*.pug ./build/views & copyfiles ./.env ./build",
    "prod:server": "babel -d ./build ./ -s --ignore node_modules,build,views & npm run copy-files:server",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "migration:create": "npx typeorm migration:create ./src/migrations/$npm_config_name"
  },
  "author": "Craig Stroman",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@graphql-yoga/subscription": "^5.0.5",
    "@urql/exchange-graphcache": "8.1.0",
    "apollo-server-core": "^3.13.0",
    "apollo-server-express": "^3.13.0",
    "cors": "^2.8.6",
    "express": "4",
    "express-session": "^1.19.0",
    "graphql": "16.12.0",
    "graphql-scalars": "1.24.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.1.0",
    "pg": "^8.22.0",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.4",
    "ws": "^8.21.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "4",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
